{
  "name": "@abd/satellite-sdk",
  "version": "1.0.0",
  "description": "Centralized SDK for ABD Ecosystem Satellites: Federated Identity, Tenant Access, and Branding.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "prepare": "tsup"
  },
  "dependencies": {
    "jose": "^6.2.3"
  },
  "peerDependencies": {
    "@abd/styles": "github:ajabadia/ABDStyles#main",
    "next": ">=14.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@abd/styles": "github:ajabadia/ABDStyles#main",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "exports": {
