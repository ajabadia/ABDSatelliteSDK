{
  "name": "@abd/satellite-sdk",
  "version": "1.0.0",
  "description": "Centralized SDK for ABD Ecosystem Satellites: Federated Identity, Tenant Access, and Branding.",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "full-audit": "powershell -File ./scripts/abd-audit.ps1"
  },
  "dependencies": {
    "jose": "^6.2.3",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@abd/styles": "^1.0.0",
    "next": ">=14.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@abd/styles": "file:../ABDStyles",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs"
    }
  },
  "keywords": [
    "abd",
    "sso",
    "multi-tenant",
    "satellite",
    "nextjs"
  ],
  "author": "Antigravity | ABD Ecosystem Architecture Team",
  "license": "UNLICENSED"
}
